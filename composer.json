{
    "name": "kzarshenas/crazyphp",
    "version": "1.1.0",
    "description": "My crazy framework for creating ultra-fast webapps.",
    "type": "library",
    "license": "MPL-2.0",
    "autoload": {
        "psr-4": {
            "CrazyPHP\\": "src/"
        }
    },
    "authors": [
        {
            "name": "kekefreedog",
            "email": "kevin.zarshenas@gmail.com"
        }
    ],
    "require": {
        "mezon/router": "^1.5",
        "splitbrain/php-cli": "^1.3",
        "league/climate": "^3.10",
        "symfony/yaml": "^6.1",
        "symfony/finder": "^6.1",
        "zordius/lightncandy": "^1.2",
        "phpfastcache/phpfastcache": "^9.1",
        "nyholm/psr7": "^1.5",
        "nyholm/psr7-server": "^1.0",
        "laminas/laminas-httphandlerrunner": "^2.3",
        "psr/http-message": "^1.0",
        "vlucas/phpdotenv": "^5.6",
        "ozdemirburak/iris": "^3.1",
        "pelago/emogrifier": "^7.3 || ^8.1",
        "monolog/monolog": "^3.8",
        "illuminate/collections": "^12.4",
        "rybakit/msgpack": "^0.9.1",
        "ramsey/uuid": "^4.9",
        "psr/clock": "^1.0",
        "lcobucci/clock": "^3.5",
        "league/route": "^6.0",
        "symfony/routing": "^7.4",
        "nikic/fast-route": "^1.3"
    },
    "suggest": {
        "workerman/workerman": "Required for Workers and WebSockets (^5.0)."
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "php -f ./vendor/phpunit/phpunit/phpunit"
        ],
        "test:e2e": [
            "Composer\\Config::disableProcessTimeout",
            "CRAZY_E2E=1 php -f ./vendor/phpunit/phpunit/phpunit -- --testsuite \"Crazy PHP | Project Creation (E2E)\""
        ],
        "test:all": [
            "@test",
            "@test:e2e"
        ]
    }
}