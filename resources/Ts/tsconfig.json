{
    "compilerOptions": {
        "strict": true,
        "target": "es6",
        "sourceMap": true,
        "module": "esnext",
        "skipLibCheck": true,
        "importHelpers": true,
        "noImplicitAny": false,
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "strictPropertyInitialization": false,
        "typeRoots": ["./node_modules/@types", "./app/Front/types"],
        "lib": ["es6", "dom", "es2017", "es2021", "es2022", "dom.iterable"],
        "esModuleInterop":true,
        "paths": {
            "tslib": ["./node_modules/tslib/tslib"],
            "killa": ["./app/Front/types/killa"],
            "@materializecss/materialize": ["./app/Front/types/materialize"]
        }
    },
    "exclude": ["./vendor/kzarshenas/crazyphp/resources/"]
}