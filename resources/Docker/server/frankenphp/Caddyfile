# Use classic PHP requests; worker mode requires application lifecycle support.
{
    frankenphp
}

{{site}} {
    root * {{public}}

    # Hide server and PHP identification headers
    header {
        -X-Powered-By
        -Server
    }

    # Match the generated PHP post_max_size limit
    request_body {
        max_size 512MiB
    }

    php_server
}
