{{!--
  ! Form
  !
  ! Form partiel
  !
  ! HANDLEBARS.JS version 4.7.7
  !
  ! @package    kzarshenas/crazyphp
  ! @author     kekefreedog <kevin.zarshenas@gmail.com>
  ! @copyright  2022-2023 Kévin Zarshenas
  !--}}
{{#if form}}{{!-- Form --}}
<form 
    id="{{form.id}}"
    class="row crazy-form g-0"
    {{!-- Entity --}}
    {{#if form.entity}}entity="{{form.entity}}"{{/if}}
    {{!-- On Ready --}}
    {{#if form.onready}}onready="{{form.onready}}"{{/if}}
    {{!-- Url where Post --}}
    {{#if form.post}}post="{{form.post}}"{{/if}} 
    {{!-- Filter --}}
    {{#if form.filter}}data-form-filter=""{{/if}} 
    {{!-- Declare partial --}}
    partial="form"
>
    {{!-- Items --}}
    {{#each form.items as |item|}}
    {{#if form.filter}}
        {{#is item.type "file"}}{{> filter/filter_file item form=form}}
        {{else}}{{#is item.type "color"}}{{> filter/filter_color item form=form}}
        {{else}}{{#is item.type "select"}}{{> filter/filter_select item form=form}}
        {{else}}{{#is item.type "password"}}{{> filter/filter_password item form=form}}
        {{else}}{{#is item.type "date"}}{{> filter/filter_date item form=form}}
        {{else}}{{#is item.type "number"}}{{> filter/filter_number item form=form}}
        {{else}}{{#is item.type "range"}}{{> filter/filter_range item form=form}}
        {{else}}{{#is item.type "switch"}}{{> filter/filter_switch item form=form}}
        {{else}}{{#is item.type "radio"}}{{> filter/filter_radio item form=form}}
        {{else}}{{#is item.type "checkbox"}}{{> filter/filter_checkbox item form=form}}
        {{else}}{{#is item.type "hidden"}}{{> filter/filter_hidden item form=form}}
        {{else}}{{> filter/filter_default item form=form}}
        {{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}
    {{else}}
        {{#is item.type "file"}}{{> form/form_file item form=form}}
        {{else}}{{#is item.type "color"}}{{> form/form_color item form=form}}
        {{else}}{{#is item.type "select"}}{{> form/form_select item form=form}}
        {{else}}{{#is item.type "password"}}{{> form/form_password item form=form}}
        {{else}}{{#is item.type "date"}}{{> form/form_date item form=form}}
        {{else}}{{#is item.type "number"}}{{> form/form_number item form=form}}
        {{else}}{{#is item.type "range"}}{{> form/form_range item form=form}}
        {{else}}{{#is item.type "switch"}}{{> form/form_switch item form=form}}
        {{else}}{{#is item.type "radio"}}{{> form/form_radio item form=form}}
        {{else}}{{#is item.type "checkbox"}}{{> form/form_checkbox item form=form}}
        {{else}}{{#is item.type "hidden"}}{{> form/form_hidden item form=form}}
        {{else}}{{> form/form_default item form=form}}
        {{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}{{/is}}
    {{/if}}
    {{/each}}

    {{!-- Submit --}}
    <div class="col s12 screen-flex screen-{{#if form.confirm.align}}{{form.confirm.align}}{{else}}left{{/if}}{{#if form.confirm.invert}} screen-direction-x-desc{{/if}}">
        {{!-- Reset Button --}}
        {{#if form.reset}}<button class="btn waves-effect waves-light red white-text m{{#if form.confirm.invert}}l{{else}}r{{/if}}-5" type="reset" {{#if form.onready}}disabled="loading"{{/if}}>Reset
            <i class="material-icons right">delete_forever</i>
        </button>{{/if}}
        {{!-- Submit button --}}
        {{#if form.confirm}}<button class="btn waves-effect waves-light green" type="submit" {{#if form.onready}}disabled="loading"{{/if}}>{{#isString form.confirm}}{{form.confirm}}{{else}}{{#isObject form.confirm}}{{#if form.confirm.title}}{{form.confirm.title}}{{/if}}{{else}}Save{{/isObject}}{{/isString}}
            {{#isObject form.confirm}}{{#if form.confirm.icon}}<i class="ml-2 {{form.confirm.icon.class}} right">{{form.confirm.icon.text}}</i>{{/if}}{{else}}<i class="ml-2 material-icons right">save</i>{{/isObject}}
        </button>{{/if}}
    </div>

</form>{{/if}}