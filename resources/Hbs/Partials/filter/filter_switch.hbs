{{!--
  ! Filter / switch
  !--}}
<div class="col s12 mn-2{{#if _style.customClass.input-field}} {{_style.customClass.input-field}}{{/if}}" style="margin-bottom: 15px;">

    <div class="input-field">
        {{#isnt _style.filter.operators false}}
        <div class="input-filter">
            <select
                data-operator-id="{{form.id}}_{{name}}"
                data-operator-name="{{name}}"
                class="filter-operator"
                aria-label="{{#if label}}{{label}} {{/if}}comparison"
                {{#if disabled}}disabled=""{{else}}{{#if form.onready}}disabled="loading"{{/if}}{{/if}}
            >
                {{#if _style.filter.operators}}
                    {{#each _style.filter.operators as |operator|}}<option value="{{operator.value}}"{{#if operator.default}} selected=""{{/if}}>{{operator.label}}</option>{{/each}}
                {{else}}
                    <option value="=">=</option>
                    <option value="!=">≠</option>
                    <option value="*" selected="">*</option>
                {{/if}}
            </select>
        </div>
        {{/isnt}}
        {{#if label}}<span class="switch-label">{{label}}</span>{{/if}}
        <div class="switch{{#if label}}  mt-4{{/if}}"><label>
            <div id="dependency" class="suffix hide"><i class="material-icons">link_off</i></div>
            {{#if disabled}}<div class="suffix"><i class="material-icons">lock</i></div>{{/if}}
            Off
            <input
                id="{{form.id}}_{{name}}"
                name="{{name}}"
                type="checkbox"
                {{#if _style.customClass.input}}class="{{_style.customClass.input}}"{{/if}}
                {{#if disabled}}disabled=""{{else}}disabled="loading"{{/if}}
                {{#unless form.onready}}{{#if default}}checked="" default="true"{{/if}}{{/unless}}
                {{#if depends}}data-depends="{{#isArray depends}}{{join "," depends}}{{else}}{{depends}}{{/isArray}}" default="true"{{/if}}
            >
            <span class="lever"></span>
            On
        </label></div>
    </div>

</div>
