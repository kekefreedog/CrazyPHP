{{!-- Form / checkbox --}}
<div partial="form/form_checkbox" class="input-field s12{{#if _style.customClass.input-field}} {{_style.customClass.input-field}}{{/if}}">

    <div id="dependency" class="suffix transparent hide"><i class="material-icons">link_off</i></div>
    {{#if disabled}}<div class="suffix transparent"><i class="material-icons">lock</i></div>{{/if}}
    <p><label>
        <input
            id="{{form.id}}_{{name}}"
            name="{{name}}"
            type="checkbox"
            {{#if required}}required=""{{/if}}
            {{#if depends}}data-depends="{{#isArray depends}}{{join depends ","}}{{else}}{{depends}}{{/isArray}}"{{/if}}
            {{#if _style.customClass.input}}class="{{_style.customClass.input}}"{{/if}}
            {{#if disabled}}disabled=""{{else}}{{#if form.onready}}disabled="loading"{{/if}}{{/if}}
            {{#unless form.onready}}{{#if default}}checked="" default="true"{{/if}}{{/unless}}
        />
        {{#if label}}<span>{{#if required}}<b>{{/if}}{{label}}{{#if required}}</b>*{{/if}}</span>{{/if}}
    </label></p>

</div>
