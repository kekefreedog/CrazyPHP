{{!--
  ! Form / checkbox
  !
  ! Renders one "checkbox" form item. Included by ../form.hbs as
  ! {{> form/form_checkbox item form=form}} — `item` becomes the partial's
  ! context (bare field access), `form` is merged in as an extra field.
  !--}}
<div class="input-field col s12 mn-2{{#if _style.customClass.input-field}} {{_style.customClass.input-field}}{{/if}}" style="margin-bottom: 15px;">

    <div id="dependency" class="suffix hide"><i class="material-icons">link_off</i></div>
    <p><label>
        {{#if disabled}}<div class="suffix"><i class="material-icons">lock</i></div>{{/if}}
        <input
            id="{{form.id}}_{{name}}"
            name="{{name}}"
            type="checkbox"
            {{#if _style.customClass.input}}class="{{_style.customClass.input}}"{{/if}}
            {{#if disabled}}disabled=""{{else}}{{#if form.onready}}disabled="loading"{{/if}}{{/if}}
            {{#unless form.onready}}{{#if default}}checked="" default="true"{{/if}}{{/unless}}
        />
        {{#if label}}<span>{{#if required}}<b>{{/if}}{{label}}{{#if required}}</b>*{{/if}}</span>{{/if}}
    </label></p>

</div>
