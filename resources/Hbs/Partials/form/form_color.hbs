{{!-- Form / color --}}
<div partial="form/form_color" class="input-field s12{{#if _style.customClass.input-field}} {{_style.customClass.input-field}}{{/if}}">

    {{#if disabled}}<div class="suffix transparent"><i class="material-icons">lock</i></div>{{else}}
    {{#if _style.suffix}}<div class="suffix transparent"><i class="{{_style.suffix.class}}">{{_style.suffix.text}}</i></div>{{/if}}{{/if}}
    {{#if _style.prefix}}<div class="prefix"><i class="{{_style.prefix.class}}">{{_style.prefix.text}}</i></div>{{/if}}
    <input
        id="{{form.id}}_{{name}}"
        name="{{name}}"
        class="no-autoinit{{#if _style.customClass.input}} {{_style.customClass.input}}{{/if}}"
        {{#if disabled}}disabled=""{{else}}{{#if form.onready}}disabled="loading"{{/if}}{{/if}}
        type="color"
        data-color-picker="{{#if _style.color.picker}}{{_style.color.picker}}{{else}}native{{/if}}"
        {{#if _style.color.picker}}
            {{#if _style.color.theme}}data-color-theme="{{_style.color.theme}}"{{/if}}
            data-color-opacity="{{_style.color.opacity}}"
            {{#if _style.color.locale}}data-color-locale="{{_style.color.locale}}"{{/if}}
        {{/if}}
        {{#if placeholder}}placeholder="{{placeholder}}"{{else}}placeholder=" "{{/if}}
        {{#if readonly}}readonly=""{{/if}}
        {{#unless form.onready}}{{#if default includeZero=true}}value="{{#is default "randomHex()"}}{{colorHexRandom}}{{else}}{{default}}{{/is}}" default="{{default}}"{{/if}}{{/unless}}
        {{#if select.[0].value includeZero=true}}min="{{select.[0].value}}"{{/if}}
        {{#if select.[1].value includeZero=true}}max="{{select.[1].value}}"{{/if}}
        {{#if required}}required=""{{/if}}
    >

    {{#if label}}<label for="{{form.id}}_{{name}}">{{#if required}}<b>{{/if}}{{label}}{{#if required}}</b>*{{/if}}</label>{{/if}}

</div>
