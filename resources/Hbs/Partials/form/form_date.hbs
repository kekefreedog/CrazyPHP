{{!-- Form / date --}}
<div partial="form/form_date" class="input-field s12{{#if _style.customClass.input-field}} {{_style.customClass.input-field}}{{/if}}">

    {{#if disabled}}<div class="suffix transparent"><i class="material-icons">lock</i></div>{{else}}
    {{#if _style.suffix}}<div class="suffix transparent"><i class="{{_style.suffix.class}}">{{_style.suffix.text}}</i></div>{{/if}}{{/if}}
    {{#if _style.prefix}}<div class="prefix"><i class="{{_style.prefix.class}}">{{_style.prefix.text}}</i></div>{{/if}}
    <input
        id="{{form.id}}_{{name}}"
        name="{{name}}{{#if multiple}}[]{{/if}}"
        {{#if multiple}}multiple=""{{/if}}
        class="no-autoinit{{#if _style.customClass.input}} {{_style.customClass.input}}{{/if}}"
        {{#if disabled}}disabled=""{{else}}{{#if form.onready}}disabled="loading"{{/if}}{{/if}}
        {{#if filterDate}}
        type="text" data-type="date" data-date-picker="air-datepicker"
        data-date-range="{{#if multiple}}true{{else}}{{#if _style.date.range}}true{{else}}false{{/if}}{{/if}}"
        {{else}}
        {{#is _style.date.picker "airdatepicker"}}type="text" data-type="date" data-date-picker="air-datepicker"{{else}}{{#is _style.date.picker "air-datepicker"}}type="text" data-type="date" data-date-picker="air-datepicker"{{else}}type="date"{{/is}}{{/is}}
        {{/if}}
        {{#if placeholder}}placeholder="{{placeholder}}"{{else}}placeholder=" "{{/if}}
        {{#if readonly}}readonly=""{{/if}}
        {{#unless form.onready}}{{#if default}}value="{{default}}" default="{{default}}"{{/if}}{{/unless}}
        {{#if select.[0].value}}min="{{select.[0].value}}"{{/if}}
        {{#if select.[1].value}}max="{{select.[1].value}}"{{/if}}
        {{#if required}}required=""{{/if}}
        {{#if _style.date.format}}data-date-format="{{_style.date.format}}"{{/if}}
        {{#if _style.date.lang}}data-date-lang="{{_style.date.lang}}"{{/if}}
        autocomplete="off"
    >
    {{#if label}}<label for="{{form.id}}_{{name}}">{{#if required}}<b>{{/if}}{{label}}{{#if required}}</b>*{{/if}}</label>{{/if}}

</div>
