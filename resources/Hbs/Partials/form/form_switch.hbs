{{!-- Form / switch --}}
<div partial="form/form_switch" class="input-field s12{{#if _style.customClass.input-field}} {{_style.customClass.input-field}}{{/if}}">

    {{#if filterLegend}}
        {{#if label}}<fieldset class="filter-control-outline" aria-hidden="true"><legend>{{#if required}}<b>{{/if}}{{label}}{{#if required}}</b>*{{/if}}</legend></fieldset>{{/if}}
    {{else}}
        {{#if label}}{{#if required}}<b>{{/if}}{{label}}{{#if required}}</b>*{{/if}}{{/if}}
    {{/if}}
    <div class="switch{{#if label}}  mt-4{{/if}}"><label>
        <div id="dependency" class="suffix transparent hide"><i class="material-icons">link_off</i></div>
        {{#if disabled}}<div class="suffix transparent"><i class="material-icons">lock</i></div>{{/if}}
        {{#if filterFile}}{{#if _style.filter.labels.notExists}}{{_style.filter.labels.notExists}}{{else}}Does not exist{{/if}}{{else}}Off{{/if}}
        <input
            id="{{form.id}}_{{name}}"
            name="{{name}}"
            type="checkbox"
            {{#if label}}aria-label="{{label}}"{{/if}}
            {{#if required}}required=""{{/if}}
            {{#if _style.customClass.input}}class="{{_style.customClass.input}}"{{/if}}
            {{#if disabled}}disabled=""{{else}}{{#if form.onready}}disabled="loading"{{/if}}{{/if}}
            {{#unless form.onready}}{{#if default}}checked="" default="true"{{/if}}{{/unless}}
            {{#if depends}}data-depends="{{#isArray depends}}{{join depends ","}}{{else}}{{depends}}{{/isArray}}"{{/if}}
        >
        <span class="lever"></span>
        {{#if filterFile}}{{#if _style.filter.labels.exists}}{{_style.filter.labels.exists}}{{else}}Exists{{/if}}{{else}}On{{/if}}
    </label></div>

</div>
