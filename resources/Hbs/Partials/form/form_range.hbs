{{!-- Form / range --}}
<div partial="form/form_range" class="s12{{#if _style.customClass.input-field}} {{_style.customClass.input-field}}{{/if}}">

    {{#if disabled}}<i class="material-icons right">lock</i>{{/if}}
    {{#unless filterLegend}}{{#if label}}{{#if required}}<b>{{/if}}{{label}}{{#if required}}</b>*{{/if}}{{/if}}{{/unless}}
    <div class="range-field mt-0">
        <input
            id="{{form.id}}_{{name}}"
            name="{{name}}"
            type="range"
            {{#if form.filter}}data-type="number"{{/if}}
            {{#if label}}aria-label="{{label}}"{{/if}}
            min="{{#if select.[0].value includeZero=true}}{{select.[0].value}}{{else}}0{{/if}}"
            max="{{#if select.[1].value includeZero=true}}{{select.[1].value}}{{else}}100{{/if}}"
            class="pt-0{{#if _style.customClass.input}} {{_style.customClass.input}}{{/if}}"
            {{#if disabled}}disabled=""{{else}}{{#if form.onready}}disabled="loading"{{/if}}{{/if}}
            {{#unless form.onready}}{{#if default includeZero=true}}value="{{default}}" default="{{default}}"{{/if}}{{/unless}}
            {{#if _style.range.step}}step="{{_style.range.step}}"{{/if}}
        />
    </div>

</div>
