{{!-- Form / password --}}
<div partial="form/form_password" class="input-field s12{{#if _style.customClass.input-field}} {{_style.customClass.input-field}}{{/if}}">

    {{#if disabled}}<div class="suffix transparent"><i class="material-icons">lock</i></div>{{else}}
    {{#if _style.password.visible}}<crazy-button class="suffix" data-password-toggle-icon type="icon" size="sm" shape="round" variant="text" color-primary="transparent" color-secondary="var(--md-sys-color-on-surface-variant)" wave="dark" icon-text="visibility" aria-label="Show password"></crazy-button>{{else}}
    {{#if _style.suffix}}<div class="suffix transparent"><i class="{{_style.suffix.class}}">{{_style.suffix.text}}</i></div>{{/if}}{{/if}}{{/if}}
    {{#if _style.prefix}}<div class="prefix"><i class="{{_style.prefix.class}}">{{_style.prefix.text}}</i></div>{{/if}}
    <input
        {{#if _style.password.visible}}data-password-toggle data-password-visible="0"{{/if}}
        id="{{form.id}}_{{name}}"
        name="{{name}}"
        class="no-autoinit{{#if _style.customClass.input}} {{_style.customClass.input}}{{/if}}"
        {{#if disabled}}disabled=""{{else}}{{#if form.onready}}disabled="loading"{{/if}}{{/if}}
        type="password"
        {{#if placeholder}}placeholder="{{placeholder}}"{{else}}placeholder=" "{{/if}}
        {{#if readonly}}readonly=""{{/if}}
        {{#unless form.onready}}{{#if default}}value="{{default}}" default="{{default}}"{{/if}}{{/unless}}
        {{#if _style.text.minlength includeZero=true}}minlength="{{_style.text.minlength}}"{{/if}}
        {{#if _style.text.maxlength includeZero=true}}maxlength="{{_style.text.maxlength}}"{{/if}}
        {{#if required}}required=""{{/if}}
    >
    {{#if label}}<label for="{{form.id}}_{{name}}">{{#if required}}<b>{{/if}}{{label}}{{#if required}}</b>*{{/if}}</label>{{/if}}

</div>
