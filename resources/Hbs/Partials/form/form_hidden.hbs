{{!--
  ! Form / hidden
  !
  ! Renders one "hidden" form item. Included by ../form.hbs as
  ! {{> form/form_hidden item form=form}} — `item` becomes the partial's
  ! context (bare field access), `form` is merged in as an extra field.
  !--}}
<div class="input-field col s12 mn-2{{#if _style.customClass.input-field}} {{_style.customClass.input-field}}{{/if}}" style="margin-bottom: 15px;">

    <input
        id="{{form.id}}_{{name}}"
        name="{{name}}"
        type="hidden"
        {{#unless form.onready}}{{#if default}}value="{{default}}" default="{{default}}"{{/if}}{{/unless}}
    >

</div>
